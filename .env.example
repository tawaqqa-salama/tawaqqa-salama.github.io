# اختياري — بدون هذه القيم يعمل الموقع بوضع تجريبي محلي (بيانات وهمية)
# محلياً: انسخ إلى .env.local
# على GitHub (هذا المستودع): Repository secrets ثم أعد نشر Deploy Pages
# الدليل: docs/SUPABASE.md و docs/P0_PRODUCTION.md
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# P0 — HMAC secret for signed session cookies (server-only, NEVER NEXT_PUBLIC_*)
# Generate: openssl rand -base64 48
# Required on Node/Vercel production. Demo/Pages use a non-production fallback when unset.
# AUTH_SESSION_SECRET=replace_with_long_random_string_min_16_chars

# اختياري — لسكربت إعداد الجداول (npm run db:apply-dds) حتى 029
# DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# P0 — وضع العرض فقط (Pages / demos). لا تفعّله على ERP الإنتاجي.
# ALLOW_DEMO_MODE=true

# P0 — فرض إرسال ZATCA عبر /api فقط (مفعّل تلقائياً في إنتاج Node)
# ZATCA_SERVER_ONLY=true
# NEXT_PUBLIC_ZATCA_SERVER_ONLY=true

# ─── WhatsApp Business Platform / Cloud API (CRM Inbox) ────────────────────
# لا تضع قيمًا حقيقية في git. استخدم .env.local أو أسرار الاستضافة فقط.
# WHATSAPP_PROVIDER=meta
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TOKEN_ENCRYPTION_KEY=   # اختياري لتشفير التوكن في DB
# WHATSAPP_ALLOW_UNSIGNED=true     # للتطوير فقط — مرفوض تماماً في production حتى لو مفعّل
# SUPABASE_SERVICE_ROLE_KEY=       # مُفضّل لكتابة Webhook متجاوزاً RLS (خادم فقط)
#
# Webhook العام للتسجيل في Meta:
#   https://YOUR_HOST/api/integrations/whatsapp/webhook
#
# مسار قديم (مزود وسيط خارجي) ما زال مدعومًا كاحتياطي:
# WHATSAPP_WEBHOOK_URL=https://your-provider.example/hooks/whatsapp
# WHATSAPP_WEBHOOK_TOKEN=optional_bearer_token
# NEXT_PUBLIC_WHATSAPP_WEBHOOK_URL=   # غير مفضّل — لا تعرض أسرارًا للواجهة

# ─── SMS / OTP (P1) ────────────────────────────────────────────────────────
# يُفضَّل تفعيل Phone OTP من لوحة Supabase Auth.
# إن فشل Supabase SMS، يُستخدم SMS_OTP_WEBHOOK_URL كبديل مع رمز مخصّص.
# SMS_OTP_WEBHOOK_URL=https://your-provider.example/hooks/sms-otp
# SMS_OTP_WEBHOOK_TOKEN=optional_bearer_token

# ─── Social Media Hub (official OAuth / APIs only) ─────────────────────────
# SOCIAL_PROVIDER_MODE=demo          # demo | live — demo adapters for local/tests
# SOCIAL_FORCE_MEMORY=true           # tests/demo memory store (not production)
# SOCIAL_TOKEN_ENCRYPTION_KEY=       # AES key for social tokens (fallback: WA key)
# META_APP_ID=
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=         # Instagram/Facebook messaging webhook
# META_API_VERSION=v21.0
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=                  # YouTube + Google Business Profile
# GOOGLE_CLIENT_SECRET=
# YOUTUBE_CLIENT_ID=                 # optional alias
# YOUTUBE_CLIENT_SECRET=
#
# Meta IG/FB messaging webhook:
#   https://YOUR_HOST/api/social/webhook/meta
# OAuth callback pattern:
#   https://YOUR_HOST/api/integrations/social/oauth/<platform>/callback

# ─── Building permit OCR / Vision (Stage 2) ────────────────────────────────
# اختياري — لاستخراج بيانات رخصة البناء من الصور عبر OpenAI Vision.
# بدون المفتاح يعمل التحليل المحلي لنصوص PDF / الأنماط النصية فقط.
# OPENAI_API_KEY=sk-...              # أيضاً لاقتراحات محتوى التسويق (مسودات فقط)
# OPENAI_VISION_MODEL=gpt-4o-mini

# ─── Multi-tenant SaaS ─────────────────────────────────────────────────────
# TENANT_FORCE_MEMORY=true           # tests/demo — in-memory tenants (not production)
# TENANT_ONBOARDING_TOKEN=           # optional shared secret for POST /api/onboarding
# DEFAULT_TENANT_CODE=TWAQQA         # bootstrap fallback when session has no companyId
# NEXT_PUBLIC_SITE_URL=https://your-host.example
